modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[userenv]

[userenv.development]
FEE_PAYMENT_RETURN_URL = "https://f8ad4f13-ad39-4544-9de2-99a39f6d556c-00-1pkz80o0gbypm.riker.replit.dev/fees/return"
COMMUNICATION_EMAIL_PROVIDER = "resend"
EMAIL_FROM = "Yetenia EduCore <notification@yetenia.com>"
RESEND_DEVELOPMENT_RECIPIENTS = "ogunlakinyemi@gmail.com"
EDUCORE_DEVELOPMENT_WORKERS_PAUSED = "true"
EDUCORE_DEVELOPMENT_PAYMENT_TEST_NOTIFICATIONS_DISABLED = "true"
EDUCORE_DEVELOPMENT_TELEGRAM_ENABLED = "true"

[userenv.production]
EDUCORE_PRODUCTION_TELEGRAM_ENABLED = "true"
COMMUNICATION_EMAIL_PROVIDER = "resend"
EMAIL_FROM = "Yetenia EduCore <notification@yetenia.com>"
EDUCORE_NOTIFICATION_LIVE_FROM = "2026-10-23T20:49:25.893Z"

[objectStorage]
defaultBucketID = "replit-objstore-2357c139-bab2-4688-9e2e-9a940e1cb1cc"
